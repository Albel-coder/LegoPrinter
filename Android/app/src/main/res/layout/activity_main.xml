<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Container for fragments (occupies all space except buttons) -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white" />

    <!-- Bottom panel with buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bottom_nav_background"
        android:paddingVertical="4dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/buttonDevice"
            style="@style/BottomNavButton"
            android:drawableTop="@drawable/ic_device_outline"
            android:text="Device" />

        <Button
            android:id="@+id/buttonPreview"
            style="@style/BottomNavButton"
            android:drawableTop="@drawable/ic_preview_outline"
            android:text="Preview" />

        <Button
            android:id="@+id/buttonPrepare"
            style="@style/BottomNavButton"
            android:drawableTop="@drawable/ic_prepare_outline"
            android:text="Prepare" />

        <Button
            android:id="@+id/buttonCalibration"
            style="@style/BottomNavButton"
            android:drawableTop="@drawable/ic_calibration_outline"
            android:text="Calibration" />

    </LinearLayout>

</LinearLayout>
