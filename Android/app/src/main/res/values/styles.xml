<resources>
    <!-- Base style for the application -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Material Design Colors -->
        <item name="colorPrimary">#6200EE</item>
        <item name="colorPrimaryDark">#3700B3</item>
        <item name="colorAccent">#03DAC5</item>
    </style>

    <!-- Style for bottom navigation buttons -->
    <style name="BottomNavButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@drawable/bottom_nav_button_background</item>
        <item name="android:textColor">@color/bottom_nav_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
